# Dedicated Studio client report worker; never copy source keys into Public Roo.
STUDIO_REPORTS_WORKER_ENABLED=false
STUDIO_REPORTS_SLACK_TEAM_ID=T_VERIFIED_WORKSPACE
STUDIO_REPORTS_DATA_DIR=./data/studio-reports
STUDIO_REPORTS_QUEUE_DIR=./data/studio-report-queue
# Optional reviewed invoice manifest in the private data volume. Missing/invalid
# configured files fail closed. Never mount invoices or this file in Public Roo.
STUDIO_REPORTS_BACKFILL_FILE=
TIMESHEET_SOURCE=linear
TIMESHEET_LINEAR_READ_API_KEY=replace-with-read-only-development-key
TIMESHEET_LINEAR_ORGANIZATION_ID=replace-with-verified-organization-uuid
TIMESHEET_SLACK_BOT_TOKEN=replace-with-roo-dev-bot-token

# Explicit verified mappings. Example IDs below are placeholders, not access grants.
TIMESHEET_PROJECTS_JSON={"00000000-0000-0000-0000-000000000001":"Example project A","00000000-0000-0000-0000-000000000002":"Example project B"}
TIMESHEET_BUILDERS_JSON=[{"builder_id":"00000000-0000-0000-0000-000000000011","slack_user_id":"UEXAMPLEBUILDER","name":"Example builder"}]
# One 40-hour allowance shared by this client's projects; never 40 per project.
# monthly_allowances optionally overrides specific YYYY-MM months (no rollover).
# Set monthly_hours to null for a staff overview with no combined allowance.
# Staff still need explicit verified project_ids; there is no wildcard access.
# Optional aliases select this client only (e.g. verified email or spelling).
# Staff report_client_ids lists the owner Slack IDs they may report for. Each
# owner's full project list must be within staff access, with no overlap between
# selected owners. Example staff entry: {"name":"Staff","project_ids":[...],
# "monthly_hours":null,"report_client_ids":["UEXAMPLECLIENT"]}.
# These grants and aliases belong only in the private worker configuration.
STUDIO_REPORTS_CLIENTS_JSON={"UEXAMPLECLIENT":{"name":"Example client","project_ids":["00000000-0000-0000-0000-000000000001","00000000-0000-0000-0000-000000000002"],"monthly_hours":40,"monthly_allowances":{}}}
