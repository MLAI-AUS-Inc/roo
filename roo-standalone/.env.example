# Roo standalone runtime configuration

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# LLM provider (configure at least one)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# External services
CONTENT_FACTORY_URL=
CONTENT_FACTORY_API_KEY=
MLAI_BACKEND_URL=https://api.mlai.au/api/v1
MLAI_API_KEY=
ROO_API_KEY=
INTERNAL_API_KEY=

# App
DEBUG=false
LOG_LEVEL=INFO
SKILLS_DIR=skills
TIMEZONE=Australia/Melbourne
ROUTER_MODEL=gpt-5.4
LINEAR_MEETING_LLM_MODEL=gpt-5.5
LINEAR_MEETING_LLM_REASONING_EFFORT=low
COWORKING_INTENTS_DB_PATH=data/coworking_booking_intents.db
COWORKING_RETRY_POLL_SECONDS=30

# Daily jobs scheduler
# Recommended production setup: keep this disabled in Roo and let
# mlai-backend own the 7am Melbourne run plus Slack posting.
JOBS_SCHEDULER_ENABLED=false

# Only needed if Roo should trigger mlai-backend jobs manually.
JOBS_API_URL=https://api.mlai.au/api/v1
JOBS_TRIGGER_TOKEN=
JOBS_SCHEDULE_HOUR=7
JOBS_SCHEDULE_MINUTE=0
JOBS_COLLECT_LIVE=true
JOBS_POST_TO_SLACK=false
JOBS_SLACK_CHANNEL=jobs-and-founder-matching
JOBS_POST_TO_NOTION=true
JOBS_MAX_PAGES=1
JOBS_PER_KEYWORD_LIMIT=5
JOBS_RETRY_ATTEMPTS=3
JOBS_RETRY_DELAY_SECONDS=300
JOBS_FAILURE_STOP_AFTER_DAYS=3

# Committee meeting agenda
# Set COMMITTEE_AGENDA_CHANNEL_ID to the Slack channel ID (e.g. C012ABCDEF) where
# agenda submissions should be posted. If unset, Roo will resolve it from
# COMMITTEE_AGENDA_CHANNEL_NAME at runtime (the bot must be a member).
COMMITTEE_AGENDA_CHANNEL_ID=
COMMITTEE_AGENDA_CHANNEL_NAME=committee-agenda
COMMITTEE_AGENDA_SECOND_EMOJI=+1
