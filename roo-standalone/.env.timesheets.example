# Dedicated worker only. Provision DEVELOPMENT credentials for local testing.
# Start with preflight and preview; neither sends messages or finalizes reports.
TIMESHEETS_ENABLED=false
TIMESHEETS_SCHEDULE_ENABLED=false
# Keep Linear until the Plane migration and coverage checks are complete.
TIMESHEET_SOURCE=linear
TIMESHEET_LINEAR_READ_API_KEY=
TIMESHEET_LINEAR_ORGANIZATION_ID=
TIMESHEET_SLACK_BOT_TOKEN=
TIMESHEET_SLACK_TEAM_ID=
# Dr Sam's verified Slack ID: the ONLY production requester and report recipient.
# Must match Public Roo's TIMESHEET_RECIPIENT_SLACK_ID; never infer from a name.
TIMESHEET_RECIPIENT_SLACK_ID=
# One-to-one manual mappings. No email/name fuzzy matching.
# [{"linear_user_id":"UUID","slack_user_id":"U...","name":"Builder name"}]
TIMESHEET_BUILDERS_JSON=[]
# The five Studio project IDs are built in. Optional explicit ID-to-name override:
# TIMESHEET_PROJECTS_JSON={"UUID":"Project display name"}
TIMESHEET_FIRST_CUTOFF=2026-09-11
# Native local development paths. Compose explicitly sets its container paths.
TIMESHEET_DATA_DIR=./data/timesheets
TIMESHEET_QUEUE_DIR=./data/timesheet-queue
