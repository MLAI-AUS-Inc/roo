[Unit]
Description=Roo Docker health watchdog
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/roo/roo-standalone
Environment=WATCHDOG_SERVICE_NAME=roo
Environment=WATCHDOG_INTERVAL_SECONDS=60
ExecStart=/srv/roo/roo-standalone/ops/docker-health-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
