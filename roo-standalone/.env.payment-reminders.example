# Copy to .env.payment-reminders. This worker does not load public/admin .env.
PAYMENT_REMINDERS_ENABLED=false
# First payment Friday anchors a 14-calendar-day cadence.
PAYMENT_FIRST_FRIDAY=2026-09-11
PAYMENT_TIMEZONE=Australia/Melbourne
# Reminder send time on Thursday. The stated payment deadline is Friday at noon.
PAYMENT_REMINDER_HOUR=9
PAYMENT_RECEIPTS_DIR=/app/data/payment-reminders
# Roo bot: chat:write, im:write, users:read, channels:read, groups:read.
# Invite the bot to the builders channel. Never an Admin Roo/user token.
PAYMENT_SLACK_BOT_TOKEN=
PAYMENT_SLACK_TEAM_ID=
# Audience: mlai-studio-builders. Every active human member is checked.
PAYMENT_SLACK_CHANNEL_ID=C0C02S608LU
# Dedicated read-only Linear API key with access to all builders' teams.
PAYMENT_LINEAR_READ_API_KEY=
PAYMENT_LINEAR_ORGANIZATION_ID=
# Verified one-to-one identities for EVERY human in the channel.
# Mappings outside the channel never receive reminders; missing mappings are errors.
# [{"slack_user_id":"U123ABC","linear_user_id":"00000000-0000-0000-0000-000000000001"}]
PAYMENT_BUILDERS_JSON=[]
