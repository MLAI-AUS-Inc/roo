# Plane CE 1.4.0 compatibility PREVIEW. Never finalizes or delivers reports.
TIMESHEETS_ENABLED=false
TIMESHEETS_SCHEDULE_ENABLED=false
TIMESHEET_SOURCE=plane
TIMESHEET_PLANE_BASE_URL=https://plane.mlai.au
TIMESHEET_PLANE_WORKSPACE=mlai
# Workspace UUID from an authenticated project response, not the instance UUID.
TIMESHEET_PLANE_WORKSPACE_ID=
# Key for an account with read access to the selected projects. Worker uses GET only.
TIMESHEET_PLANE_API_KEY=
# Plane project UUID -> existing canonical/Linear project UUID for the five paid projects.
TIMESHEET_PLANE_PROJECT_MAP_JSON={}
# Plane user UUID -> existing canonical/Linear builder UUID.
TIMESHEET_PLANE_USER_MAP_JSON={}
# Imported Plane item UUID -> ORIGINAL Linear issue UUID, never an identifier/title.
TIMESHEET_PLANE_IMPORTED_ISSUE_MAP_JSON={}

# Retain the existing logical organization ID and builder IDs for ledger continuity.
TIMESHEET_LINEAR_ORGANIZATION_ID=
TIMESHEET_BUILDERS_JSON=[]
TIMESHEET_SLACK_BOT_TOKEN=
TIMESHEET_SLACK_TEAM_ID=
TIMESHEET_RECIPIENT_SLACK_ID=
TIMESHEET_FIRST_CUTOFF=2026-09-11
# Point at a local COPY of the ledger when testing migration. Do not reset allocations.
TIMESHEET_DATA_DIR=./data/timesheet-plane-preview
TIMESHEET_QUEUE_DIR=./data/timesheet-plane-preview-queue
