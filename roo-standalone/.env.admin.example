# Roo Admin production configuration. GitHub Actions writes .env.admin from
# repository secrets; this file documents the enforced, read-only shape.

ROO_ENVIRONMENT=production
ROO_RELEASE_SHA=replace-with-reviewed-main-commit
ROO_SURFACE=admin
ROO_ADMIN_INTERNAL_ONLY=true
# Deliberately no Slack app or LLM credential: the existing Public Roo app is
# the only Slack ingress and the backend produces grounded memory answers.

MLAI_BACKEND_URL=https://api.mlai.au
MLAI_API_KEY=
ROO_API_KEY=
INTERNAL_API_KEY=
INTERNAL_MENTION_API_KEY=

# Production deploys enforce live read-only Admin Brain access. Controlled
# actions remain a separate future gate.
ROO_ENABLED_SKILLS=admin-brain
ROO_ALLOWED_CHANNEL_IDS=
ROO_ALLOWED_DM_USER_IDS=
ORG_BRAIN_ENABLED=true
ORG_BRAIN_ACTIONS_ENABLED=false
ORG_BRAIN_API_KEY=mlai_sp_replace-with-32-hex-id.replace-with-scoped-secret
ORG_BRAIN_BACKEND_TIMEOUT_SECONDS=20
ORG_BRAIN_MAX_CONTEXT_TOKENS=6000
ROO_ADMIN_DISPATCH_SECRET=replace-with-shared-random-secret-at-least-32-characters
ROO_ADMIN_DISPATCH_MAX_AGE_SECONDS=60
ROO_ADMIN_DISPATCH_RECEIPT_TTL_SECONDS=600
ROO_ADMIN_DISPATCH_RECEIPTS_DB_PATH=data/admin_dispatch_receipts.db
ROO_CONTEXTUAL_RESPONSES_ENABLED=false
ROO_CONTEXTUAL_SHADOW_MODE=false

DEBUG=false
LOG_LEVEL=INFO
SKILLS_DIR=skills
TIMEZONE=Australia/Melbourne
BOOST_LINK_LOVE_ENABLED=false
START_HERE_INTRO_ENABLED=false
JOBS_SCHEDULER_ENABLED=false
