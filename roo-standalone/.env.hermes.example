# Dedicated HOST CONTROLLER environment. Never source Public/Admin Roo .env.
# Disabled until an operator provisions the reviewed host, backend and images.
ROO_HERMES_ENABLED=false
ROO_HERMES_WORKER_ID=roo-hermes
ROO_HERMES_WORKER_KEY=
ROO_HERMES_BACKEND_ORIGIN=https://backend.example.invalid
# The backend always uses HTTPS. Only the internal fixed proxy uses HTTP.
ROO_HERMES_ALLOW_PRIVATE_HTTP=true
ROO_HERMES_BROKER_ORIGIN=http://hermes-broker:8090
ROO_HERMES_MODEL_ORIGIN=http://hermes-broker:8090
# Fill with the immutable digest of the DERIVED image after build and checks.
ROO_HERMES_IMAGE=
ROO_HERMES_NETWORK=roo-hermes-internal
ROO_HERMES_WEB_NETWORK=roo-hermes-web
ROO_HERMES_PUBLIC_WEB_ENABLED=false
ROO_HERMES_STATE_ROOT=/var/lib/roo-hermes/tasks
ROO_HERMES_RUNTIME_UID=10000
ROO_HERMES_RUNTIME_GID=10000
ROO_HERMES_TIMEOUT_SECONDS=600
ROO_HERMES_MEMORY_MB=2048
ROO_HERMES_CPUS=2
ROO_HERMES_PIDS_LIMIT=256
ROO_HERMES_POLL_SECONDS=10
ROO_HERMES_HEARTBEAT_SECONDS=10
ROO_HERMES_MAX_ARTIFACT_BYTES=6291456
ROO_HERMES_RETAIN_FAILED_WORKSPACES=false
# Infrastructure Compose inputs; these are destinations, never credentials.
ROO_HERMES_BACKEND_HOST=backend.example.invalid
# Exact DNS hostnames, comma separated. No wildcard/IP/private network access.
# Opt-in public-web Compose profile and task grant are both required.
ROO_HERMES_WEB_HOSTS=
# Authenticated browser profiles and operator takeover remain separately gated.
# Never put upstream provider keys, Slack tokens or ORG_BRAIN_API_KEY here.
